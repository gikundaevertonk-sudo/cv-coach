# ---------------------------------------------------------------------------
# CV Coach environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Which AI provider to use: "anthropic", "openai" or "deepseek".
# If left blank, the app auto-selects whichever API key is present
# (preferring Anthropic, then OpenAI, then DeepSeek).
AI_PROVIDER=

# --- Anthropic (Claude) -----------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults to "claude-opus-5".
ANTHROPIC_MODEL=

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# Optional. Defaults to "gpt-4o".
OPENAI_MODEL=

# --- DeepSeek -----------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional. Defaults to "deepseek-chat". Use "deepseek-reasoner" for R1.
DEEPSEEK_MODEL=
# Optional. Defaults to "https://api.deepseek.com".
DEEPSEEK_BASE_URL=
