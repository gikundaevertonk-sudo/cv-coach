# ---------------------------------------------------------------------------
# CV Coach environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Which AI provider to use: "anthropic", "openai" or "deepseek".
# If left blank, the app auto-selects whichever API key is present
# (preferring Anthropic, then OpenAI, then DeepSeek).
AI_PROVIDER=

# --- Anthropic (Claude) -----------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults to "claude-opus-5".
ANTHROPIC_MODEL=

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# Optional. Defaults to "gpt-4o".
OPENAI_MODEL=

# --- DeepSeek -----------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional. Defaults to "deepseek-chat". Use "deepseek-reasoner" for R1.
DEEPSEEK_MODEL=
# Optional. Defaults to "https://api.deepseek.com".
DEEPSEEK_BASE_URL=

# ===========================================================================
# Job search ("Find jobs" tab). Only needed for that tab. Configure ONE source.
# ===========================================================================

# Which job board to use: "adzuna" or "jsearch".
# Blank = auto-detect (JSearch if RAPIDAPI_KEY is set, else Adzuna).
JOBS_PROVIDER=

# --- Adzuna (free key at https://developer.adzuna.com) --------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional default country (ISO-2). Defaults to "us".
ADZUNA_COUNTRY=

# --- JSearch on RapidAPI (aggregates Google for Jobs) --------------------
# Subscribe at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
